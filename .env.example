# Vigilen runtime mode
# Use "demo" only for local prototype/localStorage mode.
# Omit or set to "production" for Supabase-backed production mode.
NEXT_PUBLIC_VIGILEN_APP_MODE=production

# Required in production mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required private evidence storage bucket.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=evidence-documents

# Evidence upload controls.
NEXT_PUBLIC_VIGILEN_MAX_UPLOAD_BYTES=10485760
NEXT_PUBLIC_VIGILEN_SIGNED_URL_TTL_SECONDS=300
